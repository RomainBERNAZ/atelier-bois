{
  "name": "atelier-bois",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "agent:demo": "node --experimental-strip-types experiments/run-copilot-agent.ts",
    "audit:deps": "npm audit --audit-level=high",
    "check": "npm run typecheck && npm run lint && npm run test:cov && npm run audit:deps"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.22",
    "zod": "^4.6.7"
  }
}
